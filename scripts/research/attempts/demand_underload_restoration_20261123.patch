+    /** Research-only destination test using present demand; physical admission remains separate. */
+    public static double prospectiveCpuDemand(final Host host, final Vm candidate, final Vm temporaryCopy) {
+        final double capacity = host.getTotalMipsCapacity();
+        if (capacity <= 0) throw new IllegalStateException("Destination has no CPU capacity");
+        final double now = host.getSimulation().clock();
+        double demand = candidate.getCpuPercentRequested(now) * candidate.getTotalMipsCapacity();
+        for (final Vm resident : host.getVmList()) {
+            if (resident != temporaryCopy && resident != candidate)
+                demand += resident.getCpuPercentRequested(now) * resident.getTotalMipsCapacity();
+        }
+        return demand / capacity;
+    }
