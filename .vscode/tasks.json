{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Prepare Java debugger",
            "type": "shell",
            "command": "./scripts/run.ps1",
            "args": ["-PrepareDebug"],
            "options": {"cwd": "${workspaceFolder}"},
            "problemMatcher": []
        },
        {
            "label": "Clean Java debugger override",
            "type": "shell",
            "command": "python",
            "args": ["scripts/framework/clear_patch.py"],
            "options": {"cwd": "${workspaceFolder}"},
            "problemMatcher": []
        },
        {
            "label": "Compare all workloads",
            "type": "shell",
            "command": "./scripts/run.ps1",
            "args": [],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Compare day-night workload",
            "type": "shell",
            "command": "./scripts/run.ps1",
            "args": [
                "-Scenario",
                "diurnal"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "Compare heavy workload",
            "type": "shell",
            "command": "./scripts/run.ps1",
            "args": [
                "-Scenario",
                "heavy"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        }
    ]
}
